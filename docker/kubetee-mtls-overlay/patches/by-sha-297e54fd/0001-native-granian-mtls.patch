+def _inbound_client_verify(cfg) -> bool:
+    """Whether the inbound listener must demand a client certificate (mTLS).
+
+    A CA bundle means the operator asked for mutual TLS: without
+    ``CERT_REQUIRED`` the context would still *load* that CA, so a client that
+    presents no certificate at all would still be accepted -- TLS, but not
+    mutual TLS, and no authentication. (KubeTEE 0005.)
+    """
+    return bool(getattr(cfg, "ssl_ca_certs", None))
+
+
+def _inbound_cert_reqs(cfg) -> int:
+    """``ssl.VerifyMode`` for uvicorn: REQUIRE when mTLS is configured."""
+    return ssl.CERT_REQUIRED if _inbound_client_verify(cfg) else ssl.CERT_NONE
+
